{
  "version": 1,
  "sdk_version": "3.6.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "painel-de-clientes-sisramos",
      "version": "0.1.0",
      "title": "PAINEL DE CLIENTES - SISRAMOS"
    },
    "tools": [
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lista os clientes do Radar (nome, tipo AC/AV, municípios, status).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "only_active": {
              "type": "boolean",
              "description": "Se verdadeiro, retorna apenas clientes ativos."
            },
            "search": {
              "type": "string",
              "description": "Filtro por parte do nome."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_collaborators",
        "title": "Listar colaboradores",
        "description": "Lista os colaboradores ativos do Radar (nome, função).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "Listar tarefas",
        "description": "Lista tarefas do Radar, com filtros opcionais por cliente, responsável e situação.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do cliente."
            },
            "assignee": {
              "type": "string",
              "description": "Nome do responsável (ex.: Patrick)."
            },
            "include_completed": {
              "type": "boolean",
              "description": "Incluir tarefas concluídas (padrão: não)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de tarefas (padrão 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
